# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/portfolio_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173
